# ══════════════════════════════════════════════════════════════════════
# CaveMemeDesk — environment (copy to .env and fill in)
# .env is gitignored. NEVER commit real keys.
# ══════════════════════════════════════════════════════════════════════

# ── RPC (required in practice) ──────────────────────────────────────────
# Free public endpoint works but 429s on getTokenLargestAccounts.
# Recommended free tier: Helius — https://dev.helius.xyz (1M credits/mo)
# or QuickNode free. Falls back to public mainnet RPC if unset.
RPC_URL=

# ── PumpPortal (optional) ───────────────────────────────────────────────
# Data WS (subscribeNewToken / subscribeMigration) works keyless.
# Add a key from https://pumpportal.fun if you have one (or if free
# methods ever require it). Metered trade streams are NOT used in v0.1.
PUMPPORTAL_API_KEY=

# ── Config override (optional) ──────────────────────────────────────────
# Alternative config file, e.g. config/test.json. Default: config/default.json
DESK_CONFIG=

# ── Telegram alerts (optional) ──────────────────────────────────────────
# Create a bot via @BotFather → token goes in TELEGRAM_BOT_TOKEN.
# Message the bot once (/start) to link your chat — or prefill TELEGRAM_CHAT_ID.
# Categories are toggled in config/default.json → "telegram": {...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LIVE TRADING (leave empty — paper mode only in v0.1) ────────────────
# Enabling requires ALL of:
#   1. LIVE_TRADING=1 below
#   2. "liveTradingEnabled": true in the config file
#   3. PRIVATE_KEY set
#   4. live engine implemented (it is a STUB in v0.1 — refuses to start)
LIVE_TRADING=

# Solana keypair (base58 or JSON array). Used ONLY by the live engine.
# The process refuses to enter live mode without LIVE_TRADING=1.
# NEVER commit this file with a real key inside.
PRIVATE_KEY=
